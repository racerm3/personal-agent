# anthropic | gemini
LLM_PROVIDER=

# API key for the active provider (Anthropic or Gemini)
API_KEY=your_api_key_here

# Optional model override (provider-specific defaults apply if unset)
# anthropic default: SDK default (sonnet)
# gemini default: gemini-2.5-flash
LLM_MODEL=

# Optional agent loop limit (default: 10)
LLM_MAX_TURNS=10

# Remote MCP server (hello-mcp on CloudHub). Leave URL empty to disable.
EXTERNAL_MCP_URL=
EXTERNAL_MCP_SERVER_NAME=

# Web UI port (used by `npm run web`). Default: 3000
WEB_PORT=
